# .env.example — copy to .env and fill in real values
#
#   cp .env.example .env
#
# .env is gitignored; never commit real secrets.

# ── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_PORT=8080

# "development" | "staging" | "production".
# Non-development requires JWT_SIGNING_KEY to be set.
APP_ENV=development

# Absolute URL of the app; used for email links and absolute redirects.
APP_BASE_URL=http://localhost:8080

# ── Datastores ───────────────────────────────────────────────────────────────
# Required. Must be an absolute URL with scheme and host.
DATABASE_URL=postgres://carelog:carelog@localhost:5432/carelog?sslmode=disable
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Ed25519 private key, PEM-encoded. Generate one with:
#   openssl genpkey -algorithm ed25519
# Optional in development, required everywhere else.
JWT_SIGNING_KEY=

# Google OAuth. Both must be set together, or neither.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Media (ImageKit) ─────────────────────────────────────────────────────────
# All three must be set together, or none. URL endpoint must be absolute.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Unset in development means emails simply aren't sent.
RESEND_API_KEY=

# ── Locale ───────────────────────────────────────────────────────────────────
# IANA timezone name; drives cron schedules and date bucketing.
DEFAULT_TIMEZONE=Asia/Jakarta

# ── Frontend ─────────────────────────────────────────────────────────────────
# Read by the browser, so it must be reachable from the client.
NEXT_PUBLIC_API_BASE=http://localhost:8080