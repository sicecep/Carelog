# .env.example — copy to .env and fill in real values
#
#   cp .env.example .env
#
# .env is gitignored; never commit real secrets.

# ── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_PORT=8080

# "development" | "staging" | "production".
# Non-development requires JWT_ED25519_SEED to be set.
APP_ENV=development

# Absolute URL of the API itself; magic-link emails point here, since the API
# is what sets the session cookies before redirecting into the web app.
APP_BASE_URL=http://localhost:8080

# Absolute URL of the Next.js web app; used for post-login redirects.
WEB_BASE_URL=http://localhost:3000

# ── Datastores ───────────────────────────────────────────────────────────────
# Required. Must be an absolute URL with scheme and host.
DATABASE_URL=postgres://carelog:carelog@localhost:5432/carelog?sslmode=disable
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Ed25519 seed: EXACTLY 32 raw bytes, base64 (standard encoding, not url-safe).
# Generate one with:
#   head -c 32 /dev/urandom | base64
#
# Optional in development, required everywhere else. Leaving it empty in
# development generates a NEW ephemeral keypair on every boot, which silently
# invalidates existing sessions — you get logged out on each server restart.
# Set a fixed value locally to avoid that. The value below is a throwaway for
# local development ONLY; never reuse it anywhere real.
JWT_ED25519_SEED=1CEzGkgZ49D9yeCiPbgOQ0fcQj06TI52yNZbulFT7cc=

# Access token lifetime (short — refresh rotates it). Go duration string.
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime. 720h = 30 days.
REFRESH_TOKEN_TTL=720h

# Cookie Domain attribute. Leave EMPTY for localhost — setting it to
# "localhost" makes browsers reject the cookie. In production set the parent
# domain (e.g. .carelog.app) so the API and web app share the session.
COOKIE_DOMAIN=

# Google OAuth. Both must be set together, or neither.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Media (ImageKit) ─────────────────────────────────────────────────────────
# All three must be set together, or none. URL endpoint must be absolute.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Unset in development means no email is sent: the magic-link URL is written to
# the API server log instead, which is how you log in locally.
RESEND_API_KEY=
# From address for outgoing mail. Must be a domain verified in Resend.
RESEND_FROM=noreply@carelog.app

# ── Locale ───────────────────────────────────────────────────────────────────
# IANA timezone name; drives cron schedules and date bucketing.
DEFAULT_TIMEZONE=Asia/Jakarta

# ── Frontend ─────────────────────────────────────────────────────────────────
# Read by the browser, so it must be reachable from the client.
NEXT_PUBLIC_API_BASE=http://localhost:8080